FROM python:3.14.7-slim

WORKDIR /app

COPY requirements.rest.txt .
RUN pip install --no-cache-dir -r requirements.rest.txt \
    && opentelemetry-bootstrap -a install

COPY api-rest-mcp.py .

# Optional OpenAPI spec, downloaded and fixed by CI
# (scripts/prepare-openapi-spec.py) into openapi/ in the build context. The
# directory always exists (openapi/.gitkeep), so this COPY works whether or
# not a spec was prepared for this API.
COPY openapi/ ./openapi/

# Path of the baked spec inside the container, e.g. /app/openapi/openapi.json.
# Empty means this API has no spec and the server only exposes raw HTTP tools.
ARG API_MCP_OPENAPI_SPEC_PATH=""
ARG API_MCP_BASE_URL
ARG API_MCP_SERVER_NAME

RUN if [ -n "${API_MCP_OPENAPI_SPEC_PATH}" ] && [ ! -f "${API_MCP_OPENAPI_SPEC_PATH}" ]; then \
        echo "API_MCP_OPENAPI_SPEC_PATH=${API_MCP_OPENAPI_SPEC_PATH} does not exist in the image" >&2; exit 1; \
    fi

ENV API_MCP_OPENAPI_SPEC_PATH=${API_MCP_OPENAPI_SPEC_PATH}
ENV API_MCP_BASE_URL=${API_MCP_BASE_URL}
ENV API_MCP_SERVER_NAME=${API_MCP_SERVER_NAME}
ENV OTEL_SERVICE_NAME="${API_MCP_SERVER_NAME} MCP"

ENV OTEL_TRACES_EXPORTER=otlp_proto_http
ENV OTEL_METRICS_EXPORTER=otlp_proto_http
ENV OTEL_LOGS_EXPORTER=otlp_proto_http
ENV OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

EXPOSE 8080

CMD ["opentelemetry-instrument", "python", "api-rest-mcp.py"]
