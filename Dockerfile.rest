FROM python:3.14.7-slim

WORKDIR /app

COPY requirements.rest.txt .
RUN pip install --no-cache-dir -r requirements.rest.txt \
    && opentelemetry-bootstrap -a install

COPY api-rest-mcp.py .

# Optional OpenAPI spec, downloaded and fixed by CI
# (scripts/prepare-openapi-spec.py). API_MCP_OPENAPI_SPEC_PATH is the full path
# of the spec file inside the image and must live under /app/, e.g.
# /app/openapi/openapi.json. Only that one file is copied in, taken from the
# same path relative to the build context (openapi/openapi.json). Empty means
# this API has no spec and the server only exposes raw HTTP tools.
ARG API_MCP_OPENAPI_SPEC_PATH=""
RUN --mount=type=bind,target=/tmp/build-context \
    if [ -n "${API_MCP_OPENAPI_SPEC_PATH}" ]; then \
        case "${API_MCP_OPENAPI_SPEC_PATH}" in \
            /app/*) ;; \
            *) echo "API_MCP_OPENAPI_SPEC_PATH=${API_MCP_OPENAPI_SPEC_PATH} must be a full path under /app/" >&2; exit 1 ;; \
        esac; \
        src="/tmp/build-context/${API_MCP_OPENAPI_SPEC_PATH#/app/}"; \
        if [ ! -f "${src}" ]; then \
            echo "API_MCP_OPENAPI_SPEC_PATH=${API_MCP_OPENAPI_SPEC_PATH}: ${API_MCP_OPENAPI_SPEC_PATH#/app/} is not a file in the build context" >&2; exit 1; \
        fi; \
        mkdir -p "$(dirname "${API_MCP_OPENAPI_SPEC_PATH}")" && cp "${src}" "${API_MCP_OPENAPI_SPEC_PATH}"; \
    fi

ARG API_MCP_BASE_URL
ARG API_MCP_SERVER_NAME

ENV API_MCP_OPENAPI_SPEC_PATH=${API_MCP_OPENAPI_SPEC_PATH}
ENV API_MCP_BASE_URL=${API_MCP_BASE_URL}
ENV API_MCP_SERVER_NAME=${API_MCP_SERVER_NAME}
ENV OTEL_SERVICE_NAME="${API_MCP_SERVER_NAME} MCP"

ENV OTEL_TRACES_EXPORTER=otlp_proto_http
ENV OTEL_METRICS_EXPORTER=otlp_proto_http
ENV OTEL_LOGS_EXPORTER=otlp_proto_http
ENV OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

EXPOSE 8080

CMD ["opentelemetry-instrument", "python", "api-rest-mcp.py"]
