FROM python:3.14.7-slim

WORKDIR /app

COPY requirements.rest.txt .
RUN pip install --no-cache-dir -r requirements.rest.txt \
    && opentelemetry-bootstrap -a install

COPY api-rest-mcp.py .

ARG API_MCP_OPENAPI_SPEC_URL
ARG API_MCP_BASE_URL
ARG API_MCP_SERVER_NAME

ENV API_MCP_OPENAPI_SPEC_URL=${API_MCP_OPENAPI_SPEC_URL}
ENV API_MCP_BASE_URL=${API_MCP_BASE_URL}
ENV API_MCP_SERVER_NAME=${API_MCP_SERVER_NAME}

ENV OTEL_BSP_MAX_QUEUE_SIZE=1
ENV OTEL_BSP_MAX_EXPORT_BATCH_SIZE=1

RUN printf '#!/bin/sh\nset -e\ncase "$API_MCP_SERVER_NAME" in\n  *MCP*) export OTEL_SERVICE_NAME="$API_MCP_SERVER_NAME" ;;\n  *) export OTEL_SERVICE_NAME="$API_MCP_SERVER_NAME MCP" ;;\nesac\nexec "$@"\n' > /entrypoint.sh \
    && chmod +x /entrypoint.sh

EXPOSE 8080

ENTRYPOINT ["/entrypoint.sh"]
CMD ["opentelemetry-instrument", "python", "api-rest-mcp.py"]
