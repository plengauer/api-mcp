{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "mergeConfidence:all-badges",
    "helpers:pinGitHubActionDigests"
  ],
  "configMigration": true,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "automerge": true,
  "ignoreTests": true,
  "ignorePaths": [".github/workflows/*.lock.yml"],
  "lockFileMaintenance": { "enabled": true }
}
